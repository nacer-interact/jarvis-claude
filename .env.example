# .env.example
#
# Public template listing every environment variable this workspace expects.
# Copy this file to .env and fill in real values there — .env.example itself
# should never contain real secrets, so it is safe to commit.
#
#   cp .env.example .env

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Google (Workspace / Cloud / OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# --- YouTube ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- o2switch (cPanel hosting) ---
O2SWITCH_CPANEL_HOST=
O2SWITCH_CPANEL_USER=
O2SWITCH_CPANEL_TOKEN=
